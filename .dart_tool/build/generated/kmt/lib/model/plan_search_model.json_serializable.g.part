PlanSearchModel _$PlanSearchModelFromJson(Map<String, dynamic> json) =>
    PlanSearchModel(
      rowNum: json['Row_Num'],
      lineCd: json['Line_CD'] as String? ?? '',
      planDate: json['Plan_Date'] as String? ?? '',
      planStartTime: json['Plan_Start_Time'] as String? ?? '',
      planStopTime: json['Plan_Stop_Time'] as String?,
      teamName: json['Team_Name'] as String? ?? '',
      shiftPeriodName: json['Shift_Period_Name'] as String? ?? '',
      b1: json['B1'] as String? ?? 'N',
      b2: json['B2'] as String? ?? 'N',
      b3: json['B3'] as String? ?? 'N',
      b4: json['B4'] as String? ?? 'N',
      ot: json['OT'] as String? ?? '',
      modelCd: json['Model_CD'] as String? ?? '',
      cycleTimes: json['Cycle_Times'] as String? ?? '',
      planTotalTime: (json['plan_total_time'] as num?)?.toInt() ?? 0,
      planFgAmt: (json['plan_fg_amt'] as num?)?.toInt() ?? 0,
      actualFgAmt: (json['actual_fg_amt'] as num?)?.toInt() ?? 0,
      ngAmt: (json['NG_Amt'] as num?)?.toInt() ?? 0,
      lineStopAmt: (json['line_stop_amt'] as num?)?.toInt() ?? 0,
      status: json['status'] as String? ?? '',
      statusName: json['status_name'] as String? ?? '',
      updatedBy: json['updated_by'] as String? ?? '',
      updatedDate: json['updated_date'] as String? ?? '',
      id: (json['id'] as num?)?.toInt() ?? 0,
      otValue: json['OT_Value'] as String?,
    );

Map<String, dynamic> _$PlanSearchModelToJson(PlanSearchModel instance) =>
    <String, dynamic>{
      'Row_Num': instance.rowNum,
      'Line_CD': instance.lineCd,
      'Plan_Date': instance.planDate,
      'Plan_Start_Time': instance.planStartTime,
      'Plan_Stop_Time': instance.planStopTime,
      'Team_Name': instance.teamName,
      'Shift_Period_Name': instance.shiftPeriodName,
      'B1': instance.b1,
      'B2': instance.b2,
      'B3': instance.b3,
      'B4': instance.b4,
      'OT': instance.ot,
      'Model_CD': instance.modelCd,
      'Cycle_Times': instance.cycleTimes,
      'plan_total_time': instance.planTotalTime,
      'plan_fg_amt': instance.planFgAmt,
      'actual_fg_amt': instance.actualFgAmt,
      'NG_Amt': instance.ngAmt,
      'line_stop_amt': instance.lineStopAmt,
      'status': instance.status,
      'status_name': instance.statusName,
      'updated_by': instance.updatedBy,
